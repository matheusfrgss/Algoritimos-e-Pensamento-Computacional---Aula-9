#include <stdio.h>

struct Produto {
    int codigo;
    char nome[50];
    float preco;
};

int main() {
    struct Produto produtos[3];
    FILE *arquivo;
    int i;

    // Receber os dados dos produtos
    for (i = 0; i < 3; i++) {
        printf("\nProduto %d\n", i + 1);

        printf("Codigo: ");
        scanf("%d", &produtos[i].codigo);

        printf("Nome: ");
        scanf(" %49[^\n]", produtos[i].nome);

        printf("Preco: ");
        scanf("%f", &produtos[i].preco);
    }

    // Abrir arquivo para escrita
    arquivo = fopen("estoque.txt", "w");

    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo!\n");
        return 1;
    }

    // Salvar os produtos no arquivo
    for (i = 0; i < 3; i++) {
        fprintf(arquivo, "%d %s %.2f\n",
                produtos[i].codigo,
                produtos[i].nome,
                produtos[i].preco);
    }

    fclose(arquivo);

    // Abrir arquivo para leitura
    arquivo = fopen("estoque.txt", "r");

    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo!\n");
        return 1;
    }

    printf("\n===== ESTOQUE DA LOJA =====\n");

    // Ler e exibir os produtos
    for (i = 0; i < 3; i++) {
        fscanf(arquivo, "%d %49s %f",
               &produtos[i].codigo,
               produtos[i].nome,
               &produtos[i].preco);

        printf("\nCodigo: %d\n", produtos[i].codigo);
        printf("Nome: %s\n", produtos[i].nome);
        printf("Preco: R$ %.2f\n", produtos[i].preco);
    }

    fclose(arquivo);

    return 0;
}
